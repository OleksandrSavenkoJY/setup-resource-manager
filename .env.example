# PostgreSQL
POSTGRES_DB=setup_resource_db
POSTGRES_USER=setup_user
POSTGRES_PASSWORD=setup_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg2://setup_user:setup_password@postgres:5432/setup_resource_db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Key used to encrypt access point passwords in the database. Set a long random value
# (for example: openssl rand -hex 32) and keep it: without it those passwords cannot be read back.
APP_SECRET_KEY=
